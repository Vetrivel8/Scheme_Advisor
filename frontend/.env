# ─── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# This file is used by Vite during `npm run dev` only.
# ⚠️  NEVER commit secrets here. This file is safe because it only holds
#     public localhost URLs. Real production values go in Vercel Dashboard.

VITE_API_URL=http://localhost:5000/api
VITE_FRONTEND_URL=http://localhost:5173

# ─── REFERENCE (for Vercel Dashboard) ─────────────────────────────────────────
# Set these in: Vercel → scheme-advisor (frontend project) → Settings → Env Vars
# VITE_API_URL=https://scheme-advisor-backend.vercel.app/api
